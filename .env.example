# .env.example
# ------------
# Copy this file to .env and fill in your values.
# If .env does not exist, the application will auto-generate
# cryptographically secure keys on first run and save them here.
#
# DO NOT commit your real .env file to version control.
# Only commit this .env.example template.

# ----------------------------------------------------------------
# STEGO_SECRET_KEY
# AES-128 encryption key used for embedding / extracting metadata.
# Must be consistent between embedding and extraction operations.
# Auto-generated (32-char hex) if not present.
# ----------------------------------------------------------------
STEGO_SECRET_KEY=your_generated_stego_key_here

# ----------------------------------------------------------------
# ADMIN_KEY
# System administrator key that grants full access to all embedded
# metadata regardless of creator_email.
# Auto-generated (32-char hex) if not present.
# ----------------------------------------------------------------
ADMIN_KEY=551d02e3ff12cfff1a3e0ad300912759

# ----------------------------------------------------------------
# SMTP CONFIGURATION (Email OTP Verification)
# Configure these to enable automated OTP verification code emails
# sent to user Gmail accounts during registration.
# (If left empty, system operates in console development fallback mode).
# ----------------------------------------------------------------
SMTP_EMAIL=your_gmail_for_sending_otp@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
